# Servidor
PORT=8080
NODE_ENV=development
# Orígenes permitidos para CORS (separados por coma): dominio del frontend
CORS_ORIGINS=http://localhost:3000
# Tamaño máximo del cuerpo de las peticiones (imágenes en base64 incluidas)
BODY_LIMIT=25mb

# Base de datos PostgreSQL
DATABASE_URL=postgres://kitacr8d:kitacr8d@localhost:5432/kitacr8d
DATABASE_SSL=false

# Autenticación
# local: usuario y contraseña propios (tokens firmados por este backend)
# oidc:  SSO con un proveedor de identidad externo (valida tokens con JWKS)
AUTH_MODE=local
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio-de-al-menos-32-caracteres
JWT_ISSUER=kitacr8d-api
JWT_AUDIENCE=kitacr8d-web
JWT_EXPIRES_IN_SECONDS=28800
# Solo para AUTH_MODE=oidc
OIDC_JWKS_URI=
OIDC_ISSUER=
OIDC_AUDIENCE=

# Proveedor de IA: azure-openai | gemini
AI_PROVIDER=azure-openai
AZURE_OPENAI_ENDPOINT=https://<recurso>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Adjuntos (imágenes de evidencias)
# local: carpeta en disco (desarrollo) | azure-blob: Azure Blob Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=kitacr8d-adjuntos
# Secreto para firmar las URLs de los adjuntos (si se omite se usa JWT_SECRET) y su vigencia
ATTACHMENT_URL_SECRET=
ATTACHMENT_URL_TTL_SECONDS=900
